# Copiez ce fichier vers .env et remplissez vos propres valeurs.
# Ne jamais committer le vrai fichier .env (il contient des secrets).

# --- Google Gemini ---
GOOGLE_API_KEY=your_google_api_key_here

# --- Jira / Atlassian ---
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# --- Clés internes des agents (générez des chaînes aléatoires) ---
AGENT1_API_KEY=generate_a_random_secret
AGENT2_API_KEY=generate_a_random_secret
